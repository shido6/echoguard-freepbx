[Unit]
Description=EchoGuard connector agent (outbound-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/echoguard-agent run --interval 10
Restart=always
RestartSec=15
# The agent only needs to read Asterisk/FreePBX state and call fwconsole.
# It never listens on a socket. Harden further with sandboxing flags if your
# distro's fwconsole/php paths allow it.
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
